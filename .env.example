PORT=4000
SITE_B_BASE_URL=http://localhost:4000

# Local Site A URL used by the existing payment callbacks.
SITE_A_BASE_URL=http://localhost:3000

# Shared secrets for the local Site A ↔ Site B payment-service contract.
SITE_A_TO_SITE_B_SECRET=replace_with_the_same_long_secret_as_phantom_cards
SITE_B_TO_SITE_A_SECRET=replace_with_the_same_long_secret_as_phantom_cards_callback

# Paystack is used only from this server. Never put this in public/app.js.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_API_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=GHS

# Keep payment-service storage separate from bundle-order storage.
PAYMENT_DATA_FILE=./data/payment-service.json
DATA_BUNDLE_DATA_FILE=./data/data-bundles.json

# Use a Paystack-approved test email for bundle checkout receipts.
DATA_BUNDLE_PAYMENT_EMAIL=danny700218+1@gmail.com

# Private token for the manual fulfillment API.
DATA_BUNDLE_ADMIN_TOKEN=replace_with_a_long_random_private_token
